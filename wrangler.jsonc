{
  // Cloudflare Worker config for the portfolio site.
  // "name" must match the Worker in Cloudflare. It also sets the address: my.pugazzh7.workers.dev
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // Everything inside /public is the website (index.html, resume.pdf, images/).
  // Nothing outside /public is ever served.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Newsletter subscribers live here, not in GitHub.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsletter",
      "database_id": "e8382d2e-707f-4731-b507-9be1c157da3d"
    }
  ],

  "observability": { "enabled": true },

  // Branch previews (Cloudflare runs `wrangler preview` for every non-main branch).
  // Previews use the same subscriber database, so a test signup on a preview link
  // lands in the real list, just like testing on the live site.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "e8382d2e-707f-4731-b507-9be1c157da3d"
      }
    ]
  }
}
